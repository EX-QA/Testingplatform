# Database Configuration
DB_USER=qaforge
DB_PASSWORD=your_secure_password_here
DB_NAME=qaforge

# JWT Configuration
JWT_SECRET=your-32-char-minimum-secret-key-here
JWT_EXPIRES_IN=7d

# CORS (set to your domain in production)
CORS_ORIGIN=http://localhost

# Note: DATABASE_URL is constructed automatically in docker-compose.yml
# Format: postgresql://user:password@db:5432/dbname
